# 本地开发（SQLite）
DATABASE_URL="file:./dev.db"

# 生产环境 SQLite 示例：
# DATABASE_URL="file:./prod.db"
# 或改为 MySQL：
# DATABASE_URL="mysql://youman:密码@127.0.0.1:3306/youman"

SESSION_SECRET="请替换为不少于32位的随机字符串"
NUXT_PUBLIC_SITE_URL="http://你的公网IP"

# 备案前用 HTTP / 公网 IP 访问时必须设为 false，否则登录 Cookie 存不住。
# 上 HTTPS 后改为 true 或删掉此行（生产默认 true）。
COOKIE_SECURE="false"
